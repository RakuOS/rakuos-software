#!/usr/bin/env python3
"""
RakuOS Software Center — entry point.
Sets cache/bytecode dirs before any imports, then launches the Qt frontend.
GTK frontend is planned for a future release once the Qt interface is complete.
"""
import os
import sys

# ── Redirect all Python bytecode out of the install tree ─────────────────────
_cache_base = os.path.join(os.path.expanduser("~"), ".cache", "rakuos")
os.makedirs(_cache_base, exist_ok=True)

os.environ["PYTHONPYCACHEPREFIX"] = os.path.join(_cache_base, "pycache")
sys.pycache_prefix = os.path.join(_cache_base, "pycache")

# ── Locate the software directory and add it to path ─────────────────────────
_here = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, _here)

# ── Check for a local package file argument (rpm/flatpak/flatpakref) ─────────
_rpm_file      = None
_flatpak_file  = None
_flatpakref    = None
_appimage_file = None

# Archive suffixes that may contain an AppImage — checked after .appimage
_APPIMAGE_ARCHIVE_SUFFIXES = (
    ".zip", ".7z", ".tar",
    ".tar.gz", ".tgz", ".tar.bz2", ".tbz2",
    ".tar.xz", ".txz", ".tar.zst", ".tzst",
    ".tar.lz", ".tar.lzma",
)

for _arg in sys.argv[1:]:
    if _arg.startswith("-") or _arg == "%f":
        continue
    # Resolve file:// URIs that some file managers pass
    if _arg.startswith("file://"):
        import urllib.parse
        _arg = urllib.parse.unquote(_arg[7:])
    if not os.path.isfile(_arg):
        continue
    _arg_lower = _arg.lower()
    _ext = os.path.splitext(_arg)[1].lower()
    if _ext == ".rpm":
        _rpm_file = _arg
    elif _ext == ".flatpak":
        _flatpak_file = _arg
    elif _ext == ".flatpakref":
        _flatpakref = _arg
    elif _ext == ".appimage":
        _appimage_file = _arg
    elif any(_arg_lower.endswith(s) for s in _APPIMAGE_ARCHIVE_SUFFIXES):
        # May be an archive containing an AppImage — hand to the AppImage flow
        _appimage_file = _arg

# Debug output so we can see what was detected
if os.environ.get("RAKUOS_DEBUG"):
    print(f"[entry] argv={sys.argv[1:]}")
    print(f"[entry] rpm={_rpm_file} flatpak={_flatpak_file} "
          f"ref={_flatpakref} appimage={_appimage_file}")

# ── Pick frontend ─────────────────────────────────────────────────────────────
# Priority: --ui=gtk/qt flag > RAKUOS_UI env var > DE auto-detect
_ui = None
for _arg in sys.argv[1:]:
    if _arg.startswith("--ui="):
        _ui = _arg.split("=", 1)[1].lower()
        sys.argv.remove(_arg)
        break

if not _ui:
    _ui = os.environ.get("RAKUOS_UI", "").lower()

if not _ui:
    _de = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    _ui = "gtk" if "gnome" in _de else "qt"

if os.environ.get("RAKUOS_DEBUG"):
    print(f"[entry] ui={_ui}")

if _ui == "gtk":
    try:
        from ui_gtk.main import run
    except ImportError as _e:
        print(f"[entry] GTK frontend unavailable ({_e}), falling back to Qt")
        from ui_qt.main import run
else:
    from ui_qt.main import run

run(rpm_file=_rpm_file, flatpak_file=_flatpak_file,
    flatpakref=_flatpakref, appimage_file=_appimage_file)