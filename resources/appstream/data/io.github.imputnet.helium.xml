  <name>Helium</name>
  <summary>A fast, private browser without Google</summary>

  <description>
    <p>
      Helium is a Chromium-based web browser that removes Google services,
      telemetry, and tracking while preserving full web compatibility.
      It ships as a drop-in replacement for Chrome with a clean, familiar
      interface and no background data collection.
    </p>
    <ul>
      <li>Google services and tracking removed at the source level</li>
      <li>Full Chromium web engine — compatible with all modern sites</li>
      <li>No sign-in required, no sync to Google accounts</li>
      <li>Supports Chrome extensions via the Web Store</li>
      <li>Regular upstream Chromium security updates</li>
    </ul>
  </description>

  <categories>
    <category>Network</category>
    <category>WebBrowser</category>
  </categories>

  <keywords>
    <keyword>browser</keyword>
    <keyword>web</keyword>
    <keyword>chromium</keyword>
    <keyword>chrome</keyword>
    <keyword>privacy</keyword>
    <keyword>helium</keyword>
  </keywords>

  <pkgname>helium</pkgname>

